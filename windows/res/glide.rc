// Windows resources for glide-client.exe (compiled by build.rs: MinGW windres for the GNU
// target, rc.exe via embed-resource for MSVC). Self-contained on purpose: no <windows.h>, so
// rc.exe works without a configured SDK INCLUDE path (e.g. on CI runners).

#define DS_SHELLFONT      0x48
#define DS_MODALFRAME     0x80
#define DS_SETFOREGROUND  0x200
#define DS_CENTER         0x800
#define WS_POPUP          0x80000000L
#define WS_CAPTION        0x00C00000L
#define WS_SYSMENU        0x00080000L
#define WS_TABSTOP        0x00010000L
#define WS_EX_APPWINDOW   0x00040000L
#define SS_ICON           0x3
#define SS_CENTERIMAGE    0x200
#define SS_CENTER         0x1
#define IDOK              1
#define IDCANCEL          2
#define VOS_NT_WINDOWS32  0x40004L
#define VFT_APP           0x1L

// GLIDE_VER_* come from the crate version (VERSION file): build.rs writes glide_version.h into
// OUT_DIR, which is on the include path for both windres and rc.exe.
#include "glide_version.h"

#define IDI_GLIDE        1
#define IDD_PAIR         102
#define IDC_PAIR_ICON    1100
#define IDC_PAIR_TEXT    1101
#define IDC_PAIR_CODE    1102
#define IDC_PAIR_DETAIL  1103

IDI_GLIDE ICON "glide.ico"
1 24 "glide.manifest"

// Pairing (security v2): both screens show the same 6-digit code; the user confirms on both.
// Texts are set at runtime (win/prompt.rs); keep this file ASCII for rc.exe.
IDD_PAIR DIALOGEX 0, 0, 262, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Glide: Pair with Mac"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL         "", IDC_PAIR_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 10, 10, 24, 24
    LTEXT           "Pair this PC with the Mac?", IDC_PAIR_TEXT, 44, 10, 208, 26
    CTEXT           "000 000", IDC_PAIR_CODE, 10, 40, 242, 32
    LTEXT           "", IDC_PAIR_DETAIL, 10, 78, 242, 44
    DEFPUSHBUTTON   "Codes Match, Pair", IDOK, 118, 128, 80, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 202, 128, 50, 14, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     GLIDE_VER_MAJOR,GLIDE_VER_MINOR,GLIDE_VER_PATCH,0
PRODUCTVERSION  GLIDE_VER_MAJOR,GLIDE_VER_MINOR,GLIDE_VER_PATCH,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Glide"
            VALUE "FileDescription", "Glide remote desktop viewer"
            VALUE "FileVersion", GLIDE_VER_STR
            VALUE "InternalName", "glide-client"
            VALUE "OriginalFilename", "glide-client.exe"
            VALUE "ProductName", "Glide"
            VALUE "ProductVersion", GLIDE_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
