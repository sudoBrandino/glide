// Windows resources for glide-client.exe (compiled by build.rs: MinGW windres for the GNU
// target, rc.exe via embed-resource for MSVC). Self-contained on purpose: no <windows.h>, so
// rc.exe works without a configured SDK INCLUDE path (e.g. on CI runners).

#define DS_SHELLFONT      0x48
#define DS_MODALFRAME     0x80
#define DS_SETFOREGROUND  0x200
#define DS_CENTER         0x800
#define WS_POPUP          0x80000000L
#define WS_CAPTION        0x00C00000L
#define WS_SYSMENU        0x00080000L
#define WS_TABSTOP        0x00010000L
#define WS_DISABLED       0x08000000L
#define WS_EX_APPWINDOW   0x00040000L
#define SS_ICON           0x3
#define SS_CENTERIMAGE    0x200
#define SS_CENTER         0x1
#define ES_AUTOHSCROLL    0x80
#define WS_BORDER         0x00800000L
#define WS_GROUP          0x00020000L
#define SS_NOPREFIX       0x80
#define WS_VSCROLL        0x00200000L
#define LVS_REPORT        0x1
#define LVS_SINGLESEL     0x4
#define LVS_SHOWSELALWAYS 0x8
#define LVS_NOSORTHEADER  0x8000
#define CBS_DROPDOWN      0x2
#define CBS_AUTOHSCROLL   0x40
#define CBS_DROPDOWNLIST  0x3
#define LBS_NOTIFY        0x1
#define LBS_NOINTEGRALHEIGHT 0x100
#define ES_MULTILINE      0x4
#define ES_AUTOVSCROLL    0x40
#define ES_READONLY       0x800
#define ES_WANTRETURN     0x1000
#define ES_NUMBER         0x2000
#define IDOK              1
#define IDCANCEL          2
#define VOS_NT_WINDOWS32  0x40004L
#define VFT_APP           0x1L

// GLIDE_VER_* come from the crate version (VERSION file): build.rs writes glide_version.h into
// OUT_DIR, which is on the include path for both windres and rc.exe.
#include "glide_version.h"

#define IDI_GLIDE        1
#define IDD_PAIR         102
#define IDC_PAIR_ICON    1100
#define IDC_PAIR_TEXT    1101
#define IDC_PAIR_CODE    1102
#define IDC_PAIR_DETAIL  1103
#define IDD_SETUP        103
#define IDC_SU_ICON      1200
#define IDC_SU_INTRO     1201
#define IDC_SU_ADDR      1202
#define IDC_SU_TEST      1203
#define IDC_SU_TEST_RESULT 1204
#define IDC_SU_ACCEPT    1205
#define IDC_SU_FIREWALL  1206
#define IDC_SU_FW_STATUS 1207
#define IDC_SU_THIS_PC   1208
#define IDC_SU_AUTOSTART 1209
#define IDC_SU_INSTALL   1210
#define IDC_SU_INSTALL_NOTE 1211
#define IDC_SU_ADDR_LABEL 1212
#define IDD_CONNS        104
#define IDC_CN_SEARCH    1300
#define IDC_CN_LIST      1301
#define IDC_CN_ADD       1302
#define IDC_CN_EDIT      1303
#define IDC_CN_DUPLICATE 1304
#define IDC_CN_REMOVE    1305
#define IDC_CN_UNPAIR    1306
#define IDC_CN_STATUS    1307
#define IDD_CONN_EDIT    105
#define IDC_CE_NAME      1400
#define IDC_CE_ADDR      1401
#define IDC_CE_TEST      1402
#define IDC_CE_TEST_RESULT 1403
#define IDC_CE_GROUP     1404
#define IDC_CE_ACCEPT    1405
#define IDC_CE_FAVORITE  1406
#define IDC_CE_ERROR     1407
// Settings: the page list, one group box per page (1501 + page), the status line and Apply; each
// page's controls are 1600 + 20 * page .. + 19 (win/settings.rs shows the current page's).
#define IDD_SETTINGS     106
#define IDC_ST_PAGES     1500
#define IDC_ST_STATUS    1590
#define IDC_ST_APPLY     1591

IDI_GLIDE ICON "glide.ico"
1 24 "glide.manifest"

// Pairing (security v2): both screens show the same 6-digit code; the user confirms on both.
// Texts are set at runtime (win/prompt.rs); keep this file ASCII for rc.exe.
// Cancel is the default button and the confirm button starts disabled (prompt.rs enables it after
// a second), and no DS_SETFOREGROUND: a request that arrives while the user is typing must not be
// confirmed by a stray Return/Space, nor take the keyboard from another app.
IDD_PAIR DIALOGEX 0, 0, 262, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Glide: Pair with Mac"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL         "", IDC_PAIR_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 10, 10, 24, 24
    LTEXT           "Pair this PC with the Mac?", IDC_PAIR_TEXT, 44, 8, 208, 30
    CTEXT           "000 000", IDC_PAIR_CODE, 10, 40, 242, 32
    LTEXT           "", IDC_PAIR_DETAIL, 10, 78, 242, 44
    PUSHBUTTON      "Codes Match, Pair", IDOK, 118, 128, 80, 14, WS_TABSTOP | WS_DISABLED
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 202, 128, 50, 14, WS_TABSTOP
END

// Setup (win/setup.rs): Mac address + test, firewall, start at sign-in, install. Tab order is
// the order below; texts that depend on state are set at runtime. Keep this file ASCII.
IDD_SETUP DIALOGEX 0, 0, 300, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Glide: Set up"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    CONTROL         "", IDC_SU_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 10, 10, 24, 24
    LTEXT           "Connect this PC to your Mac. Glide Host on the Mac shows its address in its setup window (menu bar icon, Set Up...).", IDC_SU_INTRO, 44, 10, 246, 26
    LTEXT           "&Mac's address:", IDC_SU_ADDR_LABEL, 10, 42, 120, 10
    EDITTEXT        IDC_SU_ADDR, 10, 53, 222, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Test", IDC_SU_TEST, 238, 53, 52, 14, WS_TABSTOP
    LTEXT           "", IDC_SU_TEST_RESULT, 10, 70, 280, 26
    AUTOCHECKBOX    "&Let the Mac connect to this PC", IDC_SU_ACCEPT, 10, 100, 170, 12, WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Allow in Windows Firewall", IDC_SU_FIREWALL, 182, 99, 108, 14, WS_TABSTOP
    LTEXT           "", IDC_SU_FW_STATUS, 22, 116, 268, 26
    LTEXT           "", IDC_SU_THIS_PC, 22, 144, 268, 26
    AUTOCHECKBOX    "&Start Glide when I sign in (opens without connecting)", IDC_SU_AUTOSTART, 10, 176, 280, 12, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "&Install Glide Viewer on this PC", IDC_SU_INSTALL, 10, 192, 280, 12, WS_TABSTOP
    LTEXT           "", IDC_SU_INSTALL_NOTE, 22, 205, 268, 18
    DEFPUSHBUTTON   "&Connect", IDOK, 184, 228, 52, 14, WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 240, 228, 50, 14, WS_TABSTOP
END

// Connections (win/connections.rs): search, the saved Macs (report list view, grouped at runtime
// when there is more than one group), actions on the right, a status line for the selection.
// Connect is IDOK (Enter / double-click), Close is IDCANCEL (Esc). Keep this file ASCII.
IDD_CONNS DIALOGEX 0, 0, 400, 260
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Glide: Connections"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    EDITTEXT        IDC_CN_SEARCH, 10, 8, 200, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    CONTROL         "", IDC_CN_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 10, 26, 312, 192
    DEFPUSHBUTTON   "&Connect", IDOK, 330, 26, 60, 14, WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Add...", IDC_CN_ADD, 330, 48, 60, 14, WS_TABSTOP
    PUSHBUTTON      "&Edit...", IDC_CN_EDIT, 330, 66, 60, 14, WS_TABSTOP
    PUSHBUTTON      "D&uplicate", IDC_CN_DUPLICATE, 330, 84, 60, 14, WS_TABSTOP
    PUSHBUTTON      "&Remove", IDC_CN_REMOVE, 330, 106, 60, 14, WS_TABSTOP
    PUSHBUTTON      "U&npair", IDC_CN_UNPAIR, 330, 124, 60, 14, WS_TABSTOP
    LTEXT           "", IDC_CN_STATUS, 10, 223, 312, 30, SS_NOPREFIX
    PUSHBUTTON      "Close", IDCANCEL, 330, 238, 60, 14, WS_TABSTOP | WS_GROUP
END

// Add / edit one connection (win/connections.rs). Titles, cue banners and results are set at
// runtime. Keep this file ASCII.
IDD_CONN_EDIT DIALOGEX 0, 0, 280, 196
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Glide: Connection"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "&Name:", -1, 10, 8, 120, 10
    EDITTEXT        IDC_CE_NAME, 10, 19, 260, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    LTEXT           "&Address of the Mac:", -1, 10, 38, 120, 10
    EDITTEXT        IDC_CE_ADDR, 10, 49, 202, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Test", IDC_CE_TEST, 218, 49, 52, 14, WS_TABSTOP
    LTEXT           "", IDC_CE_TEST_RESULT, 10, 66, 260, 18, SS_NOPREFIX
    LTEXT           "&Group (optional):", -1, 10, 87, 120, 10
    COMBOBOX        IDC_CE_GROUP, 10, 98, 260, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "&Let the Mac connect to this PC", IDC_CE_ACCEPT, 10, 119, 260, 12, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "&Favorite (listed first)", IDC_CE_FAVORITE, 10, 134, 260, 12, WS_TABSTOP | WS_GROUP
    LTEXT           "", IDC_CE_ERROR, 10, 151, 260, 18, SS_NOPREFIX
    DEFPUSHBUTTON   "&Save", IDOK, 162, 174, 52, 14, WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 218, 174, 52, 14, WS_TABSTOP
END

// Settings (win/settings.rs): a page list on the left; every page's controls are in this
// template, on top of each other, and only the selected page's are shown. Texts that depend on
// state are set at runtime. Keep this file ASCII.
IDD_SETTINGS DIALOGEX 0, 0, 420, 262
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Glide: Settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LISTBOX         IDC_ST_PAGES, 8, 8, 92, 226, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    GROUPBOX        "General", 1501, 108, 4, 304, 206
    GROUPBOX        "Picture", 1502, 108, 4, 304, 206
    GROUPBOX        "Keyboard and mouse", 1503, 108, 4, 304, 206
    GROUPBOX        "Audio", 1504, 108, 4, 304, 206
    GROUPBOX        "Clipboard", 1505, 108, 4, 304, 206
    GROUPBOX        "Files", 1506, 108, 4, 304, 206
    GROUPBOX        "Network and security", 1507, 108, 4, 304, 206
    GROUPBOX        "Advanced", 1508, 108, 4, 304, 206

    // General
    AUTOCHECKBOX    "&Start Glide when I sign in", 1600, 118, 20, 286, 12, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "&Connect to the Mac right away when Glide starts at sign-in", 1601, 130, 34, 274, 12, WS_TABSTOP
    LTEXT           "Off: Glide starts in the notification area and waits until you choose Connect.", 1602, 130, 48, 274, 18
    AUTOCHECKBOX    "&Pin the connection bar (always show it at the top)", 1603, 118, 72, 286, 12, WS_TABSTOP
    AUTOCHECKBOX    "Show the s&tats overlay (Ctrl+Alt+Shift+H)", 1604, 118, 88, 286, 12, WS_TABSTOP

    // Picture
    LTEXT           "Stream &mode:", 1620, 118, 20, 120, 10
    COMBOBOX        1621, 118, 31, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT           "", 1622, 118, 49, 286, 28, SS_NOPREFIX
    LTEXT           "Glide remembers which Mac display you picked for each Mac (Glide menu, Display).", 1623, 118, 84, 286, 18
    PUSHBUTTON      "&Forget remembered displays", 1624, 118, 104, 110, 14, WS_TABSTOP
    LTEXT           "", 1625, 234, 107, 170, 12, SS_NOPREFIX

    // Keyboard and mouse
    AUTOCHECKBOX    "&Ctrl acts as Command, Win as Control", 1640, 118, 20, 286, 12, WS_TABSTOP | WS_GROUP
    LTEXT           "Ctrl+C, Ctrl+V and the other shortcuts you know from Windows then work on the Mac. Alt is Option either way.", 1641, 130, 34, 274, 18
    AUTOCHECKBOX    "&Natural scrolling (reverse the wheel and touchpad)", 1642, 118, 60, 286, 12, WS_TABSTOP
    LTEXT           "Content moves with your fingers, like a Mac set to natural scrolling.", 1643, 130, 74, 274, 18

    // Audio
    AUTOCHECKBOX    "&Play the Mac's sound on this PC", 1660, 118, 20, 286, 12, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "&Muted (Ctrl+Alt+Shift+A)", 1661, 130, 34, 274, 12, WS_TABSTOP
    LTEXT           "", 1662, 118, 54, 286, 18, SS_NOPREFIX

    // Clipboard
    AUTOCHECKBOX    "&Share the clipboard with the Mac (text and images)", 1680, 118, 20, 286, 12, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "Also share items marked &private, such as copied passwords", 1681, 130, 34, 274, 12, WS_TABSTOP
    LTEXT           "Password managers mark what they copy as private so that clipboard tools leave it alone. With this on, Glide sends it to the other computer too.", 1682, 130, 48, 274, 28

    // Files
    AUTOCHECKBOX    "&File transfer (drag and drop, Send files to the Mac)", 1700, 118, 20, 286, 12, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX    "A&ccept files the Mac sends", 1701, 130, 34, 274, 12, WS_TABSTOP
    LTEXT           "Sa&ve received files in:", 1702, 118, 54, 200, 10
    EDITTEXT        1703, 118, 65, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Browse...", 1704, 302, 65, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&Default", 1705, 356, 65, 48, 14, WS_TABSTOP
    LTEXT           "Largest transfer (&GB):", 1706, 118, 90, 100, 10
    EDITTEXT        1707, 222, 88, 50, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    LTEXT           "Most f&iles per transfer:", 1708, 118, 108, 100, 10
    EDITTEXT        1709, 222, 106, 50, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_BORDER | WS_TABSTOP | WS_GROUP
    LTEXT           "The limits apply both ways: a bigger transfer is refused.", 1710, 118, 126, 286, 18

    // Network and security
    LTEXT           "&Listen port:", 1720, 118, 20, 60, 10
    EDITTEXT        1721, 180, 18, 40, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_BORDER | WS_TABSTOP | WS_GROUP
    LTEXT           "Glide uses 7420. The Mac must use the same port.", 1722, 226, 20, 178, 10
    AUTOCHECKBOX    "Let the &Mac connect to this PC", 1723, 118, 36, 286, 12, WS_TABSTOP | WS_GROUP
    LTEXT           "Allowed Mac a&ddresses, one per line. Empty: the first Mac that connects is remembered.", 1724, 118, 54, 286, 10
    EDITTEXT        1725, 118, 65, 286, 30, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_BORDER | WS_TABSTOP | WS_GROUP
    LTEXT           "Pai&red Macs:", 1726, 118, 100, 200, 10
    CONTROL         "", 1727, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 118, 111, 230, 50
    PUSHBUTTON      "&Unpair", 1728, 352, 111, 52, 14, WS_TABSTOP
    LTEXT           "This viewer's &key:", 1729, 118, 166, 200, 10
    EDITTEXT        1730, 118, 177, 230, 14, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "C&opy", 1731, 352, 177, 52, 14, WS_TABSTOP
    LTEXT           "The Mac shows it under Paired Viewers.", 1732, 118, 194, 286, 10

    // Advanced
    LTEXT           "Settings are saved in:", 1740, 118, 20, 286, 10
    EDITTEXT        1741, 118, 31, 286, 14, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "&Open config file...", 1742, 118, 50, 100, 14, WS_TABSTOP
    LTEXT           "Changes made in the file apply when Glide restarts. Saving here before then overwrites them.", 1743, 118, 68, 286, 18
    PUSHBUTTON      "&Reset to defaults...", 1744, 118, 94, 100, 14, WS_TABSTOP
    LTEXT           "Resets the settings on every page. Saved connections, pairings and allowed addresses stay.", 1745, 118, 112, 286, 18

    LTEXT           "", IDC_ST_STATUS, 108, 214, 304, 20, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 254, 240, 50, 14, WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 308, 240, 50, 14, WS_TABSTOP
    PUSHBUTTON      "&Apply", IDC_ST_APPLY, 362, 240, 50, 14, WS_TABSTOP | WS_DISABLED
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     GLIDE_VER_MAJOR,GLIDE_VER_MINOR,GLIDE_VER_PATCH,0
PRODUCTVERSION  GLIDE_VER_MAJOR,GLIDE_VER_MINOR,GLIDE_VER_PATCH,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Glide"
            VALUE "FileDescription", "Glide remote desktop viewer"
            VALUE "FileVersion", GLIDE_VER_STR
            VALUE "InternalName", "glide-client"
            VALUE "OriginalFilename", "glide-client.exe"
            VALUE "ProductName", "Glide"
            VALUE "ProductVersion", GLIDE_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
